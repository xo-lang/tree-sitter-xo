{
  "grammars": [
    {
      "name": "xo",
      "camelcase": "Xo",
      "scope": "source.xo",
      "path": ".",
      "file-types": [
        "xo"
      ],
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Xo grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-xo"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
