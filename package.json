  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "prebuildify": "^6.0.0",
    "tree-sitter-cli": "^0.27.2"
  },
  "scripts": {
    "install": "node-gyp-build",
    "test": "tree-sitter test",
    "build": "tree-sitter generate"
