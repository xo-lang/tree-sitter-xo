{
  "name": "@xo-lang/tree-sitter-xo",
  "version": "0.1.1",
  "description": "Xo grammar for tree-sitter",
  "license": "MIT",
  "author": "Joseph Spurrier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xo-lang/tree-sitter-xo.git"
  },
  "homepage": "https://github.com/xo-lang/tree-sitter-xo#readme",
  "bugs": {
    "url": "https://github.com/xo-lang/tree-sitter-xo/issues"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "xo"
  ],
  "files": [
